<div data-poris-runtime-cad-parking hidden>
<section data-poris-runtime-cad data-binding-id="<%= binding.id %>" data-project-id="<%= project.id %>"
         data-applied-label="<%= l(:text_poris_arch_runtime_applied) %>" data-waiting-label="<%= l(:text_poris_arch_runtime_waiting) %>"
         data-idle-label="<%= l(:text_poris_arch_runtime_idle) %>"
         <%= 'hidden' unless %w[configuration automated_validation].include?(@project_tab) %>>
  <% if bindings.many? %>
    <%= form_tag project_poris_viewer_path(project), method: :get do %>
      <%= hidden_field_tag :tab, @project_tab %>
      <%= select_tag :cad_binding_id, options_for_select(bindings.map { |entry| ["#{entry.system.csid} — #{entry.component.subject}", entry.id] }, binding.id), aria: {label: l(:label_poris_arch_runtime_cad)} %>
      <%= submit_tag l(:button_apply) %>
    <% end %>
  <% end %>
  <p data-runtime-cad-status role="status" aria-live="polite" hidden></p>
  <div id="architecture-cad-item-<%= binding.component.id %>">
    <%= render partial: 'cosmosys_arch/cad_imports/viewer', locals: {poris_simulation: true, presentation_only: true} %>
  </div>
  <script type="application/json" data-runtime-cad-initial><%= raw json_escape(initial_batch.to_json) %></script>
</section>
</div>
<% content_for :header_tags do %>
  <script type="module">
    import {initializeRuntimeCad} from <%= raw asset_path('plugin_assets/cosmosys_poris_arch/runtime_view.js').to_json %>;
    initializeRuntimeCad();
  </script>
<% end %>
